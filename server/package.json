{
  "name": "@cloud-media-vault/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "npm run db:generate && tsc -p tsconfig.check.json",
    "test": "vitest run",
    "build": "npm run db:generate && tsc",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:test:migrate": "node scripts/migrate.mjs --test",
    "db:test:status": "node scripts/migrate.mjs --test --status",
    "db:check": "tsx scripts/check-database.ts",
    "cloud:check": "tsx scripts/check-cloud.ts",
    "test:db": "npm run db:generate && npm run db:test:migrate && tsx test/integration/database.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cloudinary": "2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
