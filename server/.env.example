# Copiar a server/.env. Pegar credenciales solo en ese archivo ignorado por Git.
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
MAX_FILE_SIZE_MB=10
# Neon: base cloud_media_vault, URL con pooling activado (host -pooler).
DATABASE_URL=
# Misma base, URL directa con pooling desactivado. Conservar sslmode=require.
DIRECT_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cloud-media-vault
CLOUDINARY_TIMEOUT_MS=30000
